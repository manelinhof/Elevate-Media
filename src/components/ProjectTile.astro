---
import type { Project } from '../lib/projects';
import { mediaUrl } from '../data/site';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  mediaBase: string;
  // Set by the cluster layout (src/pages/[lang]/index.astro) when this tile
  // is inside the Home spiral. Adds `.tile--spin`, which the script below
  // uses to autoplay the loop immediately (no poster placeholder, no hover
  // gate) and to drive the hover highlight/dim effect between cluster tiles.
  spinning?: boolean;
}

const { project, lang, mediaBase, spinning } = Astro.props;
const title = project.title[lang];
const posterSrc = mediaUrl(mediaBase, project.poster);
const loopSrc = mediaUrl(mediaBase, project.loop);
---

<!--
  Tiles never load the full reel — only ever the short silent loop; the full
  reel loads only on click (the /work/[slug] page). Any change that
  autoplays full reels here is a regression — CLAUDE.md. Plain-grid tiles
  reveal that loop via IntersectionObserver; Home's spiral tiles (.tile--spin)
  play it immediately and continuously instead — see the script below.
-->
<a
  class:list={['tile', { 'tile--spin': spinning }]}
  href={`/${lang}/work/${project.slug}`}
  data-title={title}
>
  <img
    class="tile__poster"
    src={posterSrc}
    alt={title}
    loading="lazy"
    decoding="async"
    width="640"
    height="360"
  />
  <video class="tile__loop" data-src={loopSrc} muted playsinline loop preload="none"></video>
  <span class="tile__title">{title}</span>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }
  /* Plain grid tiles (Works page) only — cluster tiles (.tile--spin) have
     their own hover transform below, already tuned for the spiral layout. */
  .tile:not(.tile--spin) {
    transition:
      transform 350ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 300ms ease,
      filter 300ms ease;
  }
  .tile:not(.tile--spin):hover {
    transform: scale(1.12);
    z-index: 1;
  }
  /* Set on every other grid tile when one is hovered — same "not the focus"
     treatment as the cluster's .tile--spin.is-dimmed below, see the script
     tag for the shared dim-siblings-on-hover logic. */
  .tile:not(.tile--spin).is-dimmed {
    opacity: 0.35;
    filter: grayscale(1);
  }
  .tile__poster,
  .tile__loop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__loop {
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .tile__loop.is-playing {
    opacity: 1;
  }
  /* Cluster mode (Home, src/pages/[lang]/index.astro): the wrapper
     (.tile-position) handles placement and moves independently along the
     shared spiral path — each tile translates on its own, nothing orbits
     rigidly as one disc anymore, so there's no counter-rotation needed here;
     the tile's own poster/video just stays upright as-is. This class is
     also used by ProjectTile's own script (below) to tell cluster tiles
     apart from plain-grid ones, and to drive the hover highlight/dim
     effect on pointer-capable devices. */
  .tile--spin {
    width: 100%;
    height: 100%;
    aspect-ratio: unset;
    transition:
      opacity 300ms ease,
      filter 300ms ease,
      transform 300ms ease;
  }
  .tile--spin:hover {
    transform: scale(1.28);
  }
  /* Set on every other cluster tile (not the hovered one) — see the script
     below. Grayscale + reduced opacity, not a third accent colour: this is
     removing colour to signal "not the focus," which is still state, not
     decoration (CLAUDE.md "Colour is state"). */
  .tile--spin.is-dimmed {
    opacity: 0.35;
    filter: grayscale(1);
  }

  .tile__title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.75rem 1rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: #fff;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9rem;
  }
</style>

<script>
  // Astro dedupes this script across every ProjectTile instance on the
  // page, so this runs once and drives every tile with shared logic —
  // not one listener/observer set up per tile.
  import { shouldAutoplay } from '../lib/motion-prefs';

  const play = (video: HTMLVideoElement) => {
    if (!video.src && video.dataset.src) {
      video.src = video.dataset.src;
    }
    video.play().catch(() => {});
    // Wait for an actual frame before crossfading over the poster — adding
    // is-playing immediately would swap in a still-blank <video> the moment
    // playback is *requested*, not when it's actually ready, which can flash
    // black for a frame. This keeps the poster→video handoff seamless
    // regardless of what triggered play() (hover, autoplay, visibility).
    if (video.readyState >= 2) {
      video.classList.add('is-playing');
    } else {
      video.addEventListener('loadeddata', () => video.classList.add('is-playing'), {
        once: true,
      });
    }
  };
  const pause = (video: HTMLVideoElement) => {
    video.pause();
    video.classList.remove('is-playing');
  };

  if (shouldAutoplay()) {
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    const allTiles = document.querySelectorAll<HTMLAnchorElement>('.tile');
    const gridVideos: HTMLVideoElement[] = [];
    const clusterTiles: HTMLAnchorElement[] = [];
    const gridTiles: HTMLAnchorElement[] = [];

    allTiles.forEach((tile) => {
      const video = tile.querySelector<HTMLVideoElement>('.tile__loop');
      if (!video) return;

      if (tile.classList.contains('tile--spin')) {
        // Cluster tiles: no placeholder — the loop plays immediately and
        // continuously, on every device, not gated behind hover.
        clusterTiles.push(tile);
        play(video);
      } else {
        gridVideos.push(video);
        gridTiles.push(tile);
      }
    });

    // Dim-siblings-on-hover: shared between the cluster and the plain grid —
    // hovering one tile dims every other tile in its own group (cluster
    // tiles never dim grid tiles or vice versa). Only meaningful on
    // pointer-capable devices (touch has no hover to trigger it); the
    // hovered tile's own scale-up is plain CSS (:hover, see style block
    // above) since it needs no cross-tile coordination.
    const dimSiblingsOnHover = (tiles: HTMLAnchorElement[], onEnter?: (tile: HTMLAnchorElement) => void, onLeave?: () => void) => {
      tiles.forEach((tile) => {
        tile.addEventListener('mouseenter', () => {
          tiles.forEach((t) => t.classList.toggle('is-dimmed', t !== tile));
          onEnter?.(tile);
        });
        tile.addEventListener('mouseleave', () => {
          tiles.forEach((t) => t.classList.remove('is-dimmed'));
          onLeave?.();
        });
      });
    };

    // #hover-label only exists on Home (src/pages/[lang]/index.astro, where
    // it replaces the footer) — this no-ops harmlessly on any other page
    // that renders ProjectTile (e.g. the Works page's plain grid).
    const hoverLabel = document.getElementById('hover-label');
    if (canHover && clusterTiles.length > 0) {
      dimSiblingsOnHover(
        clusterTiles,
        (tile) => {
          // Elevate the hovered tile above its overlapping cluster
          // neighbors. This can't be done in CSS on the tile itself: its
          // parent .tile-position always carries an inline `transform` (its
          // --x/--y spiral placement), and any `transform` establishes a
          // new stacking context — that traps a z-index set on the tile
          // inside its own wrapper's context, so it never actually competes
          // with sibling tiles for stacking order. Bumping the wrapper's
          // own z-index from here is what actually works.
          const wrapper = tile.parentElement;
          if (wrapper) wrapper.style.zIndex = '2';
          if (hoverLabel) {
            hoverLabel.textContent = tile.dataset.title ?? '';
            hoverLabel.classList.add('is-visible');
          }
        },
        () => {
          clusterTiles.forEach((t) => {
            if (t.parentElement) t.parentElement.style.zIndex = '';
          });
          hoverLabel?.classList.remove('is-visible');
        }
      );
    }
    if (canHover && gridTiles.length > 0) {
      dimSiblingsOnHover(gridTiles);
    }

    // Plain grid tiles: visibility-based autoplay via a single shared
    // IntersectionObserver.
    if (gridVideos.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) play(video);
            else pause(video);
          }
        },
        { rootMargin: '200px' }
      );
      gridVideos.forEach((video) => observer.observe(video));
    }
  }
  // If reduced-motion or saveData is set, `data-src` is never promoted to
  // `src`, so the loop video is never fetched at all — not just paused.
</script>
