---
import type { Project } from '../lib/projects';
import { mediaUrl } from '../data/site';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  mediaBase: string;
  // Set by the cluster layout (src/pages/[lang]/index.astro) when this tile
  // is inside the slowly-rotating cluster wrapper. Applies a counter-
  // rotation so the tile's own content stays upright while its position
  // orbits with the parent — see the wrapper's `.tile-position` styling.
  spinning?: boolean;
}

const { project, lang, mediaBase, spinning } = Astro.props;
const title = project.title[lang];
const posterSrc = mediaUrl(mediaBase, project.poster);
const loopSrc = mediaUrl(mediaBase, project.loop);
---

<!--
  Grid tiles never load the full reel. Poster → IntersectionObserver → short
  silent loop; the full reel loads only on click (the /work/[slug] page).
  Any change that autoplays full reels here is a regression — CLAUDE.md.
-->
<a class:list={['tile', { 'tile--spin': spinning }]} href={`/${lang}/work/${project.slug}`}>
  <img
    class="tile__poster"
    src={posterSrc}
    alt={title}
    loading="lazy"
    decoding="async"
    width="640"
    height="360"
  />
  <video class="tile__loop" data-src={loopSrc} muted playsinline loop preload="none"></video>
  <span class="tile__title">{title}</span>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }
  .tile__poster,
  .tile__loop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__loop {
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .tile__loop.is-playing {
    opacity: 1;
  }
  /* Cluster mode: the wrapper (.tile-position, in index.astro) handles
     absolute placement and slowly orbits with the whole cluster. This
     counter-rotates at the exact same speed in the opposite direction —
     via the --cluster-spin-duration custom property inherited from the
     cluster container — so the tile's own poster/video stays upright
     while its position orbits. prefers-reduced-motion already collapses
     all animation-duration globally (see global.css), so this is
     automatically neutralized for those users.

     Gated behind the same min-width: 960px breakpoint as .tile-position
     in index.astro — below that, .tile-position has no positioning of its
     own (mobile stays the plain grid), so this must not spin either, or
     tiles would visibly rotate in place with no compensating parent
     rotation. */
  @media (min-width: 960px) {
    .tile--spin {
      width: 100%;
      height: 100%;
      aspect-ratio: unset;
      animation: tile-counter-spin var(--cluster-spin-duration, 180s) linear infinite;
      transform-origin: center center;
    }
  }
  @keyframes tile-counter-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }

  .tile__title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.75rem 1rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: #fff;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9rem;
  }
</style>

<script>
  // Astro dedupes this script across every ProjectTile instance on the
  // page, so this runs once and drives every tile with a single shared
  // observer — not one IntersectionObserver per tile.
  import { shouldAutoplay } from '../lib/motion-prefs';

  if (shouldAutoplay()) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (!video.src && video.dataset.src) {
              video.src = video.dataset.src;
            }
            video.play().catch(() => {});
            video.classList.add('is-playing');
          } else {
            video.pause();
            video.classList.remove('is-playing');
          }
        }
      },
      { rootMargin: '200px' }
    );

    document.querySelectorAll<HTMLVideoElement>('.tile__loop').forEach((video) => {
      observer.observe(video);
    });
  }
  // If reduced-motion or saveData is set, `data-src` is never promoted to
  // `src`, so the loop video is never fetched at all — not just paused.
</script>
