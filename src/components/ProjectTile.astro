---
import type { Project } from '../lib/projects';
import { mediaUrl } from '../data/site';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  mediaBase: string;
  // Set by the cluster layout (src/pages/[lang]/index.astro) when this tile
  // is inside the slowly-rotating cluster wrapper. Applies a counter-
  // rotation so the tile's own content stays upright while its position
  // orbits with the parent — see the wrapper's `.tile-position` styling.
  spinning?: boolean;
}

const { project, lang, mediaBase, spinning } = Astro.props;
const title = project.title[lang];
const posterSrc = mediaUrl(mediaBase, project.poster);
const loopSrc = mediaUrl(mediaBase, project.loop);
---

<!--
  Grid tiles never load the full reel. Poster → IntersectionObserver → short
  silent loop; the full reel loads only on click (the /work/[slug] page).
  Any change that autoplays full reels here is a regression — CLAUDE.md.
-->
<a class:list={['tile', { 'tile--spin': spinning }]} href={`/${lang}/work/${project.slug}`}>
  <img
    class="tile__poster"
    src={posterSrc}
    alt={title}
    loading="lazy"
    decoding="async"
    width="640"
    height="360"
  />
  <video class="tile__loop" data-src={loopSrc} muted playsinline loop preload="none"></video>
  <span class="tile__title">{title}</span>
</a>

<style>
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
  }
  .tile__poster,
  .tile__loop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__loop {
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .tile__loop.is-playing {
    opacity: 1;
  }
  /* Cluster mode (Home, src/pages/[lang]/index.astro): the wrapper
     (.tile-position) handles placement and moves independently along the
     shared spiral path — each tile translates on its own, nothing orbits
     rigidly as one disc anymore, so there's no counter-rotation needed here;
     the tile's own poster/video just stays upright as-is. This class is
     still used by ProjectTile's own script (below) to tell cluster tiles
     apart from plain-grid ones for the hover-vs-touch play behavior. */
  .tile--spin {
    width: 100%;
    height: 100%;
    aspect-ratio: unset;
  }

  .tile__title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0.75rem 1rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: #fff;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9rem;
  }
</style>

<script>
  // Astro dedupes this script across every ProjectTile instance on the
  // page, so this runs once and drives every tile with shared logic —
  // not one listener/observer set up per tile.
  import { shouldAutoplay } from '../lib/motion-prefs';

  const play = (video: HTMLVideoElement) => {
    if (!video.src && video.dataset.src) {
      video.src = video.dataset.src;
    }
    video.play().catch(() => {});
    video.classList.add('is-playing');
  };
  const pause = (video: HTMLVideoElement) => {
    video.pause();
    video.classList.remove('is-playing');
  };

  if (shouldAutoplay()) {
    // .tile--spin tiles (the Home cluster) render at every viewport width
    // now, but hover-to-play only makes sense on pointer-capable devices —
    // touch has no real "hover" to trigger playback with. On touch, ring
    // tiles just stay a static poster (tap still navigates via the <a>);
    // they deliberately don't fall into the IntersectionObserver path
    // either, since many ring tiles are visible at once and that would mean
    // several videos autoplaying simultaneously in a compact layout.
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    const allTiles = document.querySelectorAll<HTMLAnchorElement>('.tile');
    const gridVideos: HTMLVideoElement[] = [];

    allTiles.forEach((tile) => {
      const video = tile.querySelector<HTMLVideoElement>('.tile__loop');
      if (!video) return;

      if (tile.classList.contains('tile--spin')) {
        if (canHover) {
          tile.addEventListener('mouseenter', () => play(video));
          tile.addEventListener('mouseleave', () => pause(video));
        }
      } else {
        gridVideos.push(video);
      }
    });

    // Plain grid tiles: unchanged — visibility-based autoplay via a single
    // shared IntersectionObserver.
    if (gridVideos.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) play(video);
            else pause(video);
          }
        },
        { rootMargin: '200px' }
      );
      gridVideos.forEach((video) => observer.observe(video));
    }
  }
  // If reduced-motion or saveData is set, `data-src` is never promoted to
  // `src`, so the loop video is never fetched at all — not just paused.
</script>
