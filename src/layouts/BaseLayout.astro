---
import { Icon } from 'astro-icon/components';
import { BRAND, OPERATOR } from '../data/site';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  // Home omits the footer — the hovered project's name takes over that
  // space instead (see src/pages/[lang]/index.astro). Every other page
  // keeps the normal footer.
  hideFooter?: boolean;
  // For pages that open with a full-bleed photo section meant to render
  // behind the header (currently just work/[slug].astro's hero). Swaps the
  // header from sticky+solid to fixed+scrim: fixed takes it out of normal
  // flow entirely, so the page's first section starts at true y=0 instead
  // of being pushed down by the header's own height — no need to know or
  // guess that height. The scrim (not fully transparent) keeps nav text
  // legible against whatever photo is behind it, same technique as
  // Hero.astro's .hero__scrim.
  transparentHeader?: boolean;
}

const { lang, title, hideFooter = false, transparentHeader = false } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const otherPath = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`);

const homeHref = `/${lang}/`;
const workHref = `/${lang}/work/`;
const aboutHref = `/${lang}/about/`;
const servicesHref = `/${lang}/services/`;
const isWorkActive = Astro.url.pathname.includes('/work');
const isAboutActive = Astro.url.pathname.includes('/about');
const isServicesActive = Astro.url.pathname.includes('/services');
const year = new Date().getFullYear();

// OPERATOR.whatsapp is still the 'TODO' placeholder from src/data/site.ts
// (CLAUDE.md open task 5) — this link is intentionally non-functional until
// the real number is filled in.
const whatsappHref = `https://wa.me/${OPERATOR.whatsapp.replace(/\D/g, '')}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {BRAND.displayName}</title>
    <!-- Resolve the theme before first paint (stored choice, else OS
         preference) so there's no flash of the wrong theme. Must run
         synchronously here, not in the deferred module script below. -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class:list={['site-header', { 'site-header--transparent': transparentHeader }]} id="site-header">
      <!--
        "Home" is no longer a nav destination — clicking the brand/logo
        does that job instead (bare page-root navigation always lands at
        scroll position 0). The nav.home i18n key stays, repurposed as
        this link's accessible name.
      -->
      <a class="site-header__brand" href={homeHref} aria-label={t('nav.home')}>
        <span class="site-header__logo" aria-hidden="true"></span>
        <span class="site-header__wordmark">{BRAND.displayName}</span>
      </a>

      <div class="site-header__center">
        <a class:list={['nav-link', { active: isWorkActive }]} href={workHref} aria-label={t('nav.work')}>
          <span class="nav-link__chars" aria-hidden="true">
            {t('nav.work').split('').map((c) => <span class="char">{c}</span>)}
          </span>
        </a>
      </div>

      <div class="site-header__right">
        <a class:list={['nav-link', { active: isServicesActive }]} href={servicesHref} aria-label={t('nav.services')}>
          <span class="nav-link__chars" aria-hidden="true">
            {t('nav.services').split('').map((c) => <span class="char">{c}</span>)}
          </span>
        </a>
        <a class:list={['nav-link', { active: isAboutActive }]} href={aboutHref} aria-label={t('nav.about')}>
          <span class="nav-link__chars" aria-hidden="true">
            {t('nav.about').split('').map((c) => <span class="char">{c}</span>)}
          </span>
        </a>
        <a class="nav-link nav-link--icon" href={otherPath} aria-label={t('lang.switch')}>
          <Icon name="lucide:globe" class="nav-link__icon" aria-hidden="true" />
        </a>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          aria-label={t('theme.toggleLight')}
          data-label-light={t('theme.toggleLight')}
          data-label-dark={t('theme.toggleDark')}
        >
          <Icon name="lucide:sun" class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true" />
          <Icon name="lucide:moon" class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true" />
        </button>
        <a class="nav-link nav-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          {t('nav.contact')}
        </a>
      </div>

      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="site-header"
        aria-label={t('nav.menuOpen')}
        data-label-open={t('nav.menuOpen')}
        data-label-close={t('nav.menuClose')}
      >
        <Icon name="lucide:menu" class="menu-toggle__icon menu-toggle__icon--open" aria-hidden="true" />
        <Icon name="lucide:x" class="menu-toggle__icon menu-toggle__icon--close" aria-hidden="true" />
      </button>
    </header>
    <main>
      <slot />
    </main>
    {!hideFooter && (
      <footer class="site-footer">
        <span>{BRAND.displayName}</span>
        <a href={BRAND.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
        <span class="site-footer__rights">© {year} {BRAND.displayName}</span>
      </footer>
    )}
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    /* Equal 1fr outer columns (not auto) so the center column (Works) lands
       on the header's true midpoint regardless of how wide the brand vs.
       right-side nav are — matching the Home cluster's spinning logo, which
       centers on the actual viewport, not on the leftover space between
       unequal siblings. */
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg);
    transition: background 300ms ease;
  }
  /* See the transparentHeader prop comment above — fixed (not sticky) so
     the hero photo behind it starts at true y=0, and a scrim gradient
     (not flat transparent) so nav text stays legible over a photo of
     unknown brightness. */
  .site-header--transparent {
    position: fixed;
    left: 0;
    right: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55), transparent);
    /* The scrim above is always dark, in both themes — but --fg/--muted go
       dark in light mode (correct for the normal solid --bg header, wrong
       here). Overriding them locally covers every child at once (brand
       wordmark, nav links, theme-toggle icon, mobile menu icon), since
       they all already reference var(--fg)/var(--muted) rather than a
       literal colour. --accent-gold (active link) and .nav-cta (fixed
       gold gradient + dark text) are already theme-independent and don't
       need an override. */
    --fg: #fff;
    --muted: rgba(255, 255, 255, 0.75);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--fg);
  }
  /* Rendered as a CSS mask, not an <img>, so its colour follows
     --logo-color (var(--fg) normally, yellow in light mode — see
     global.css and CLAUDE.md's "colour is state" exception) rather than
     the flat grey baked into logo.png. */
  .site-header__logo {
    display: block;
    width: 32px;
    height: 32px;
    background-color: var(--logo-color);
    mask: url('/logo.png') center / contain no-repeat;
    -webkit-mask: url('/logo.png') center / contain no-repeat;
    transition:
      transform 600ms ease,
      background-color 300ms ease;
  }
  /* A drone-rotor mark gets a rotor spin on hover — a small signature
     detail tied to the logo's own shape, not decoration for its own sake.
     Neutralized automatically under prefers-reduced-motion (global.css). */
  .site-header__brand:hover .site-header__logo {
    transform: rotate(360deg);
  }

  .site-header__center {
    justify-self: center;
  }
  .site-header__right {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    justify-self: end;
  }

  /* Hover and active share one visual language (the underline). The
     scramble-text hover (script below) rewrites each .char span's content
     in place, character by character; this component just needs to render
     normally when JS never attaches (non-hover-capable, reduced-motion, or
     no-JS) — the .nav-link__chars wrapper is plain inline text otherwise. */
  .nav-link {
    position: relative;
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;
    color: var(--fg);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    transition: color 200ms ease;
  }
  /* aria-hidden (see markup) — the real accessible name is the <a>'s own
     aria-label, set to the plain, unsplit string. */
  .nav-link__chars {
    display: inline-block;
  }
  /* Fixed width per character slot, not just per word: a min-width on the
     whole word only sets a floor, and random scramble letters (drawn from
     the full alphabet) render wider than a specific word's own letters
     often enough (e.g. "About", "Português") to blow past it anyway,
     reflowing this flex nav row and shifting sibling links. A fixed
     per-character width can't grow no matter which letter is showing, so
     the word's total width — and the row's layout — never moves. */
  .nav-link__chars .char {
    display: inline-block;
    width: 0.72em;
    text-align: center;
  }
  .nav-link:hover {
    color: var(--muted);
  }
  .nav-link.active {
    /* Gold, matching the CTA — not --class-b. Still state (current page),
       just using the accent that's now the site's "premium" signal instead
       of the VFR blue, since the two now sit right next to each other in
       the header and blue read as mismatched next to the gold CTA. */
    color: var(--accent-gold);
  }
  /* Language switch: an icon, not text, so it skips the scramble-hover
     script entirely (that script only touches .char spans — see below) and
     just gets the plain color transition every other .nav-link has. */
  .nav-link--icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .nav-link__icon {
    width: 18px;
    height: 18px;
  }

  /* The one deliberate "primary action" on the page — a solid-fill pill
     rather than the shared underline treatment, so it reads as the single
     thing to click, not another nav destination. Gold, not the blue/magenta
     state accents: reuses --accent-gold (the logo's existing brand-accent
     exception — see global.css) rather than adding a third colour. Fully
     rounded and a hover shine-sweep for the "premium" feel, both pure CSS —
     see the ::before pseudo-element below for the sweep mechanics. */
  .nav-cta {
    position: relative;
    overflow: hidden;
    padding: 0.55rem 1.3rem;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent-gold) 85%, white),
      var(--accent-gold) 55%,
      color-mix(in srgb, var(--accent-gold) 80%, black)
    );
    color: #171200;
    box-shadow: 0 2px 10px color-mix(in srgb, var(--accent-gold) 35%, transparent);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }
  .nav-cta:hover {
    color: #171200;
    transform: scale(1.05);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--accent-gold) 55%, transparent);
  }
  /* The shine sweep: a skewed light band sitting just off the button's left
     edge, translated across on hover. Skipped by the scramble-hover script
     (it only touches .char spans, which .nav-cta never has) and neutralized
     automatically under prefers-reduced-motion (global.css kills the
     transition duration, so it just doesn't visibly sweep). */
  .nav-cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-20deg);
    transition: left 550ms ease;
  }
  .nav-cta:hover::before {
    left: 130%;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.3rem;
    color: var(--muted);
    cursor: pointer;
    transition: color 200ms ease;
  }
  .theme-toggle:hover {
    color: var(--fg);
  }
  .theme-toggle__icon {
    width: 18px;
    height: 18px;
  }

  .menu-toggle {
    display: none;
    justify-self: end;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.4rem;
    color: var(--fg);
    cursor: pointer;
  }
  .menu-toggle__icon {
    width: 24px;
    height: 24px;
  }
  .menu-toggle__icon--close {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--close {
    display: block;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .site-footer__rights {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Narrow viewports: collapse center/right nav into a hamburger-triggered
     overlay instead of the tight-but-cramped inline layout from the
     previous iteration. */
  @media (max-width: 640px) {
    .site-header {
      gap: 0.75rem;
      padding: 1rem;
      grid-template-columns: auto auto 1fr auto;
    }
    .site-header__logo {
      width: 24px;
      height: 24px;
    }
    .menu-toggle {
      display: inline-flex;
    }

    .site-header__center,
    .site-header__right {
      display: none;
      justify-self: stretch;
    }
    .site-header[data-menu-open='true'] .site-header__center,
    .site-header[data-menu-open='true'] .site-header__right {
      display: flex;
      grid-column: 1 / -1;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding-top: 1rem;
    }
    .site-header[data-menu-open='true'] .site-header__right {
      padding-top: 0;
      padding-bottom: 0.5rem;
      border-top: 1px solid var(--border);
      margin-top: 0.5rem;
    }
    .nav-link {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { prefersReducedMotion } from '../lib/motion-prefs';

  const header = document.getElementById('site-header') as HTMLElement;
  // Every nav link is a real page now (Home/Works/About/Services/language
  // switch) — active state is set server-side via Astro.url.pathname (see
  // BaseLayout's frontmatter), not tracked client-side. This selector is
  // just for the magnetic-hover effect below.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const reducedMotion = prefersReducedMotion();

  // ---- Lenis smooth scroll ----
  // JS-driven (requestAnimationFrame), so the CSS reduced-motion override
  // (global.css) can't reach it — skip entirely and fall back to plain
  // native scroll (already instant under reduced motion via that same
  // override's `scroll-behavior: auto !important`).
  let lenis: Lenis | null = null;
  if (!reducedMotion) {
    lenis = new Lenis();
    const raf = (time: number) => {
      lenis?.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);

    // Exposed for other pages' own <script> tags (each page's script is a
    // separate module, so it can't see this file's module-scoped `lenis`
    // otherwise) — the Home cluster (src/pages/[lang]/index.astro) reads
    // scroll velocity off this instance to drive its spiral.
    (window as unknown as { __lenis: Lenis }).__lenis = lenis;
    window.dispatchEvent(new CustomEvent('lenis:ready'));
  }

  // ---- GSAP entrance animation ----
  if (!reducedMotion) {
    gsap.from(['.site-header__brand', '.site-header__center', '.site-header__right'], {
      opacity: 0,
      y: -12,
      duration: 0.5,
      ease: 'power2.out',
      stagger: 0.08,
    });
  }

  // ---- Scramble-text hover (pointer-capable devices only) ----
  // Each character cycles through random letters before resolving to the
  // real one, left to right — .nav-cta (the one filled button) is skipped
  // so its label stays stable and readable as a call to action.
  if (!reducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const SCRAMBLE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const DURATION = 1100; // ms — slow, deliberate reveal
    const FLICKER_INTERVAL = 55; // ms between random-character swaps per span

    navLinks.forEach((link) => {
      if (link.classList.contains('nav-cta')) return;
      const spans = [...link.querySelectorAll<HTMLSpanElement>('.char')];
      if (spans.length === 0) return;
      const finalChars = spans.map((span) => span.textContent ?? '');
      let frame = 0;

      const settle = () => {
        cancelAnimationFrame(frame);
        spans.forEach((span, i) => {
          span.textContent = finalChars[i];
        });
      };

      link.addEventListener('mouseenter', () => {
        cancelAnimationFrame(frame);
        const start = performance.now();
        let lastFlicker = 0;
        const step = (now: number) => {
          const elapsed = now - start;
          const dueForFlicker = now - lastFlicker >= FLICKER_INTERVAL;
          if (dueForFlicker) lastFlicker = now;
          let settled = true;
          spans.forEach((span, i) => {
            // Later characters start resolving later, so the reveal reads
            // left-to-right instead of every letter landing at once.
            const revealAt = (i / spans.length) * DURATION * 0.7 + DURATION * 0.3;
            if (elapsed >= revealAt) {
              span.textContent = finalChars[i];
            } else {
              settled = false;
              // Throttled so letters flicker at a calm, readable pace
              // instead of re-randomizing every animation frame (~16ms).
              if (dueForFlicker) {
                span.textContent = SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
              }
            }
          });
          if (!settled) frame = requestAnimationFrame(step);
        };
        frame = requestAnimationFrame(step);
      });

      // Always snap back to the real word on mouseleave — otherwise a quick
      // hover that interrupts the scramble mid-flight would leave the link
      // showing garbled text at rest.
      link.addEventListener('mouseleave', settle);
    });
  }

  // ---- Theme toggle ----
  const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement;
  const root = document.documentElement;

  const applyThemeLabel = () => {
    const isLight = root.dataset.theme === 'light';
    themeToggle.setAttribute('aria-label', (isLight ? themeToggle.dataset.labelDark : themeToggle.dataset.labelLight) ?? '');
  };
  applyThemeLabel();

  themeToggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
    applyThemeLabel();
  });

  // ---- Mobile menu toggle ----
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const isOpen = () => header.dataset.menuOpen === 'true';

  const openMenu = () => {
    header.dataset.menuOpen = 'true';
    menuToggle.setAttribute('aria-expanded', 'true');
    menuToggle.setAttribute('aria-label', menuToggle.dataset.labelClose ?? '');
  };

  function closeMenu() {
    if (!isOpen()) return;
    header.dataset.menuOpen = 'false';
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', menuToggle.dataset.labelOpen ?? '');
  }

  menuToggle.addEventListener('click', () => {
    if (isOpen()) closeMenu();
    else openMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
