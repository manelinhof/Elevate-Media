---
import { Icon } from 'astro-icon/components';
import { BRAND } from '../data/site';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const otherPath = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`);

const homeHref = `/${lang}/`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {BRAND.displayName}</title>
  </head>
  <body>
    <header class="site-header" id="site-header">
      <!--
        "Home" is no longer a nav destination — clicking the brand/logo
        does that job instead (bare page-root navigation always lands at
        scroll position 0). The nav.home i18n key stays, repurposed as
        this link's accessible name.
      -->
      <a class="site-header__brand" href={homeHref} aria-label={t('nav.home')}>
        <img class="site-header__logo" src="/logo.png" alt="" width="32" height="32" />
        <span class="site-header__wordmark">{BRAND.displayName}</span>
      </a>

      <div class="site-header__center">
        <a class="nav-link" href={`${homeHref}#work`} data-section="work">{t('nav.work')}</a>
      </div>

      <div class="site-header__right">
        <a class="nav-link" href={`${homeHref}#services`} data-section="services">{t('nav.services')}</a>
        <a class="nav-link" href={`${homeHref}#about`} data-section="about">{t('nav.about')}</a>
        <a class="nav-link" href={otherPath}>{t('lang.switch')}</a>
      </div>

      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="site-header"
        aria-label={t('nav.menuOpen')}
        data-label-open={t('nav.menuOpen')}
        data-label-close={t('nav.menuClose')}
      >
        <Icon name="lucide:menu" class="menu-toggle__icon menu-toggle__icon--open" aria-hidden="true" />
        <Icon name="lucide:x" class="menu-toggle__icon menu-toggle__icon--close" aria-hidden="true" />
      </button>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>{BRAND.displayName}</span>
      <a href={BRAND.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
      <span class="site-footer__rights">© {year} {BRAND.displayName}</span>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--fg);
  }
  .site-header__logo {
    display: block;
    width: 32px;
    height: 32px;
    object-fit: contain;
    transition: transform 600ms ease;
  }
  /* A drone-rotor mark gets a rotor spin on hover — a small signature
     detail tied to the logo's own shape, not decoration for its own sake.
     Neutralized automatically under prefers-reduced-motion (global.css). */
  .site-header__brand:hover .site-header__logo {
    transform: rotate(360deg);
  }

  .site-header__center {
    justify-self: center;
  }
  .site-header__right {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    justify-self: end;
  }

  /* Hover and active share one visual language (the underline), rather
     than hover getting one treatment and active another. The GSAP
     magnetic-hover script (below) moves the link itself via transform;
     this CSS transform is only the fallback for non-hover-capable/reduced-
     motion contexts where the JS effect never attaches. */
  .nav-link {
    position: relative;
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    transition:
      color 200ms ease,
      letter-spacing 200ms ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--class-b);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 250ms ease;
  }
  .nav-link:hover {
    color: var(--fg);
    letter-spacing: 0.09em;
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }
  .nav-link.active {
    color: var(--class-b);
  }

  .menu-toggle {
    display: none;
    justify-self: end;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.4rem;
    color: var(--fg);
    cursor: pointer;
  }
  .menu-toggle__icon {
    width: 24px;
    height: 24px;
  }
  .menu-toggle__icon--close {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--close {
    display: block;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .site-footer__rights {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Narrow viewports: collapse center/right nav into a hamburger-triggered
     overlay instead of the tight-but-cramped inline layout from the
     previous iteration. */
  @media (max-width: 640px) {
    .site-header {
      gap: 0.75rem;
      padding: 1rem;
      grid-template-columns: auto auto 1fr auto;
    }
    .site-header__logo {
      width: 24px;
      height: 24px;
    }
    .menu-toggle {
      display: inline-flex;
    }

    .site-header__center,
    .site-header__right {
      display: none;
      justify-self: stretch;
    }
    .site-header[data-menu-open='true'] .site-header__center,
    .site-header[data-menu-open='true'] .site-header__right {
      display: flex;
      grid-column: 1 / -1;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding-top: 1rem;
    }
    .site-header[data-menu-open='true'] .site-header__right {
      padding-top: 0;
      padding-bottom: 0.5rem;
      border-top: 1px solid var(--border);
      margin-top: 0.5rem;
    }
    .nav-link {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { prefersReducedMotion } from '../lib/motion-prefs';

  const header = document.getElementById('site-header') as HTMLElement;
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link[data-section]');
  const reducedMotion = prefersReducedMotion();

  // ---- Scrollspy for the single-page nav (#work/#about/#services). ----
  // No-ops safely on pages that don't have these section ids (work/[slug],
  // gallery) — same defensive pattern as the motion-prefs-driven scripts
  // elsewhere in the codebase.
  const ids = ['work', 'about', 'services'];
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const setActive = (id: string) => {
    navLinks.forEach((link) => {
      link.classList.toggle('active', link.dataset.section === id);
    });
  };

  if (sections.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (visible) {
          const id = visible.target.id;
          setActive(id);
          history.replaceState(null, '', `#${id}`);
        }
      },
      { rootMargin: '-40% 0px -40% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );

    sections.forEach((el) => observer.observe(el));
  }

  // ---- Lenis smooth scroll ----
  // JS-driven (requestAnimationFrame), so the CSS reduced-motion override
  // (global.css) can't reach it — skip entirely and fall back to plain
  // native scroll (already instant under reduced motion via that same
  // override's `scroll-behavior: auto !important`).
  let lenis: Lenis | null = null;
  if (!reducedMotion) {
    lenis = new Lenis();
    const raf = (time: number) => {
      lenis?.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);
  }

  // ---- Nav click handling: Lenis scrollTo + close mobile menu ----
  navLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      const hashIndex = link.getAttribute('href')?.indexOf('#') ?? -1;
      if (hashIndex === -1) return; // language switch etc. — normal navigation

      const targetId = link.getAttribute('href')!.slice(hashIndex + 1);
      const targetEl = document.getElementById(targetId);
      // Section doesn't exist on this page (e.g. clicked from /work/[slug])
      // — let the browser do a real navigation to the home page instead.
      if (!targetEl) return;

      event.preventDefault();
      closeMenu();
      if (lenis) {
        const headerHeight = header.offsetHeight;
        lenis.scrollTo(targetEl, { offset: -headerHeight });
      } else {
        targetEl.scrollIntoView();
        history.replaceState(null, '', `#${targetId}`);
        setActive(targetId);
      }
    });
  });

  // ---- GSAP entrance animation ----
  if (!reducedMotion) {
    gsap.from(['.site-header__brand', '.site-header__center', '.site-header__right'], {
      opacity: 0,
      y: -12,
      duration: 0.5,
      ease: 'power2.out',
      stagger: 0.08,
    });
  }

  // ---- GSAP magnetic hover (pointer-capable devices only) ----
  if (!reducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    navLinks.forEach((link) => {
      link.addEventListener('mousemove', (event) => {
        const rect = link.getBoundingClientRect();
        const x = event.clientX - rect.left - rect.width / 2;
        const y = event.clientY - rect.top - rect.height / 2;
        gsap.to(link, { x: x * 0.35, y: y * 0.5, duration: 0.3, ease: 'power2.out' });
      });
      link.addEventListener('mouseleave', () => {
        gsap.to(link, { x: 0, y: 0, duration: 0.4, ease: 'elastic.out(1, 0.4)' });
      });
    });
  }

  // ---- Mobile menu toggle ----
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const isOpen = () => header.dataset.menuOpen === 'true';

  const openMenu = () => {
    header.dataset.menuOpen = 'true';
    menuToggle.setAttribute('aria-expanded', 'true');
    menuToggle.setAttribute('aria-label', menuToggle.dataset.labelClose ?? '');
  };

  function closeMenu() {
    if (!isOpen()) return;
    header.dataset.menuOpen = 'false';
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', menuToggle.dataset.labelOpen ?? '');
  }

  menuToggle.addEventListener('click', () => {
    if (isOpen()) closeMenu();
    else openMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
