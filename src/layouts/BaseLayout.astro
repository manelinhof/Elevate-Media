---
import { BRAND } from '../data/site';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
}

const { lang, title } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const otherPath = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`);

const homeHref = `/${lang}/`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {BRAND.displayName}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-header__brand" href={homeHref}>{BRAND.displayName}</a>
      <nav class="site-header__nav">
        <a href={`${homeHref}#home`} data-section="home">{t('nav.home')}</a>
        <a href={`${homeHref}#about`} data-section="about">{t('nav.about')}</a>
        <a href={`${homeHref}#services`} data-section="services">{t('nav.services')}</a>
        <a href={otherPath}>{t('lang.switch')}</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>{BRAND.displayName}</span>
      <a href={BRAND.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
      <span class="site-footer__rights">© {year} {BRAND.displayName}</span>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .site-header__brand {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .site-header__nav {
    display: flex;
    gap: 1.75rem;
  }
  .site-header__nav a {
    text-decoration: none;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
  }
  .site-header__nav a.active {
    color: var(--class-b);
  }
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .site-footer__rights {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>

<script>
  // Scrollspy for the single-page nav (#home/#about/#services). No-ops
  // safely on pages that don't have these section ids (work/[slug],
  // gallery) — same defensive pattern as the motion-prefs-driven scripts.
  const ids = ['home', 'about', 'services'];
  const sections = ids
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0) {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(
      '.site-header__nav a[data-section]'
    );

    const setActive = (id: string) => {
      navLinks.forEach((link) => {
        link.classList.toggle('active', link.dataset.section === id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        // If nothing crosses the band this tick, keep the last known-good
        // active state rather than clearing it.
        if (visible) {
          const id = visible.target.id;
          setActive(id);
          history.replaceState(null, '', `#${id}`);
        }
      },
      { rootMargin: '-40% 0px -40% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );

    sections.forEach((el) => observer.observe(el));
  }
</script>
