---
import { Icon } from 'astro-icon/components';
import { BRAND } from '../data/site';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  // Home omits the footer — the hovered project's name takes over that
  // space instead (see src/pages/[lang]/index.astro). Every other page
  // keeps the normal footer.
  hideFooter?: boolean;
  // For pages that open with a full-bleed photo section meant to render
  // behind the header (currently just work/[slug].astro's hero). Swaps the
  // header from sticky+solid to fixed+scrim: fixed takes it out of normal
  // flow entirely, so the page's first section starts at true y=0 instead
  // of being pushed down by the header's own height — no need to know or
  // guess that height. The scrim (not fully transparent) keeps nav text
  // legible against whatever photo is behind it, same technique as
  // Hero.astro's .hero__scrim.
  transparentHeader?: boolean;
}

const { lang, title, hideFooter = false, transparentHeader = false } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const otherPath = Astro.url.pathname.replace(`/${lang}/`, `/${otherLang}/`);

const homeHref = `/${lang}/`;
const workHref = `/${lang}/work/`;
const aboutHref = `/${lang}/about/`;
const isWorkActive = Astro.url.pathname.includes('/work');
const isAboutActive = Astro.url.pathname.includes('/about');
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {BRAND.displayName}</title>
    <!-- Resolve the theme before first paint (stored choice, else OS
         preference) so there's no flash of the wrong theme. Must run
         synchronously here, not in the deferred module script below. -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class:list={['site-header', { 'site-header--transparent': transparentHeader }]} id="site-header">
      <!--
        "Home" is no longer a nav destination — clicking the brand/logo
        does that job instead (bare page-root navigation always lands at
        scroll position 0). The nav.home i18n key stays, repurposed as
        this link's accessible name.
      -->
      <a class="site-header__brand" href={homeHref} aria-label={t('nav.home')}>
        <span class="site-header__logo" aria-hidden="true"></span>
        <span class="site-header__wordmark">{BRAND.displayName}</span>
      </a>

      <div class="site-header__center">
        <a class:list={['nav-link', { active: isWorkActive }]} href={workHref} aria-label={t('nav.work')}>
          <span class="nav-link__chars" aria-hidden="true">
            {t('nav.work').split('').map((c) => <span class="char">{c}</span>)}
          </span>
        </a>
      </div>

      <div class="site-header__right">
        <a class:list={['nav-link', { active: isAboutActive }]} href={aboutHref} aria-label={t('nav.about')}>
          <span class="nav-link__chars" aria-hidden="true">
            {t('nav.about').split('').map((c) => <span class="char">{c}</span>)}
          </span>
        </a>
        <a class="nav-link nav-link--icon" href={otherPath} aria-label={t('lang.switch')}>
          <Icon name="lucide:globe" class="nav-link__icon" aria-hidden="true" />
        </a>
        <button
          type="button"
          class="theme-toggle"
          id="theme-toggle"
          role="switch"
          aria-checked="true"
          aria-label={t('theme.toggleLight')}
          data-label-light={t('theme.toggleLight')}
          data-label-dark={t('theme.toggleDark')}
        >
          <span class="theme-toggle__track">
            <Icon name="lucide:sun" class="theme-toggle__icon" aria-hidden="true" />
            <Icon name="lucide:moon" class="theme-toggle__icon" aria-hidden="true" />
            <span class="theme-toggle__thumb" aria-hidden="true"></span>
          </span>
        </button>
        <button type="button" class="nav-link nav-cta" id="contact-open">
          {t('nav.contact')}
        </button>
      </div>

      <button
        type="button"
        class="menu-toggle"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="site-header"
        aria-label={t('nav.menuOpen')}
        data-label-open={t('nav.menuOpen')}
        data-label-close={t('nav.menuClose')}
      >
        <Icon name="lucide:menu" class="menu-toggle__icon menu-toggle__icon--open" aria-hidden="true" />
        <Icon name="lucide:x" class="menu-toggle__icon menu-toggle__icon--close" aria-hidden="true" />
      </button>
    </header>
    <main>
      <slot />
    </main>
    {!hideFooter && (
      <footer class="site-footer">
        <span>{BRAND.displayName}</span>
        <a href={BRAND.instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
        <span class="site-footer__rights">© {year} {BRAND.displayName}</span>
      </footer>
    )}

    <!--
      Native <dialog>, not a hand-rolled modal — free focus trap, ESC-to-
      close, and ::backdrop styling. The submit button is a plain
      type="submit" (no formmethod override) so the script below can
      preventDefault and POST via fetch; the close (X) button uses
      formmethod="dialog" instead, which the browser closes the dialog for
      natively with no JS needed.
    -->
    <dialog id="contact-modal" class="contact-modal">
      <form id="contact-form" class="contact-form" novalidate>
        <button
          type="submit"
          formmethod="dialog"
          class="contact-form__close"
          aria-label={t('contact.close')}
        >
          <Icon name="lucide:x" aria-hidden="true" />
        </button>
        <h2 class="contact-form__heading">{t('contact.heading')}</h2>
        <p class="contact-form__intro">{t('contact.intro')}</p>

        <label class="contact-form__field">
          <span class="label">{t('contact.name')}</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label class="contact-form__field">
          <span class="label">{t('contact.email')}</span>
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label class="contact-form__field">
          <span class="label">{t('contact.phone')}</span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>
        <label class="contact-form__field">
          <span class="label">{t('contact.message')}</span>
          <textarea name="message" required rows="4"></textarea>
        </label>

        <!-- Honeypot — invisible and unreachable by keyboard for real
             visitors (aria-hidden, tabindex="-1", off-screen via CSS).
             Bots that blanket-fill every field trip it; checked
             server-side in src/pages/api/contact.ts. -->
        <label class="contact-form__hp" aria-hidden="true">
          Company
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>

        <button
          type="submit"
          class="contact-form__submit"
          id="contact-submit"
          data-label-idle={t('contact.submit')}
          data-label-sending={t('contact.sending')}
        >
          {t('contact.submit')}
        </button>
        <p
          class="contact-form__status"
          id="contact-status"
          role="status"
          aria-live="polite"
          data-success={t('contact.success')}
          data-error={t('contact.error')}
        ></p>
      </form>
    </dialog>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: grid;
    /* Equal 1fr outer columns (not auto) so the center column (Works) lands
       on the header's true midpoint regardless of how wide the brand vs.
       right-side nav are — matching the Home cluster's spinning logo, which
       centers on the actual viewport, not on the leftover space between
       unequal siblings. */
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg);
    transition: background 300ms ease;
  }
  /* See the transparentHeader prop comment above — fixed (not sticky) so
     the hero photo behind it starts at true y=0, and a scrim gradient
     (not flat transparent) so nav text stays legible over a photo of
     unknown brightness. */
  .site-header--transparent {
    position: fixed;
    left: 0;
    right: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55), transparent);
    /* The scrim above is always dark, in both themes — but --fg/--muted go
       dark in light mode (correct for the normal solid --bg header, wrong
       here). Overriding them locally covers every child at once (brand
       wordmark, nav links, theme-toggle icon, mobile menu icon), since
       they all already reference var(--fg)/var(--muted) rather than a
       literal colour. --accent-gold (active link) and .nav-cta (fixed
       gold gradient + dark text) are already theme-independent and don't
       need an override. */
    --fg: #fff;
    --muted: rgba(255, 255, 255, 0.75);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--fg);
  }
  /* Rendered as a CSS mask, not an <img>, so its colour follows
     --logo-color (var(--fg) normally, yellow in light mode — see
     global.css and CLAUDE.md's "colour is state" exception) rather than
     the flat grey baked into logo.png. */
  .site-header__logo {
    display: block;
    width: 32px;
    height: 32px;
    background-color: var(--logo-color);
    mask: url('/logo.png') center / contain no-repeat;
    -webkit-mask: url('/logo.png') center / contain no-repeat;
    transition:
      transform 600ms ease,
      background-color 300ms ease;
  }
  /* A drone-rotor mark gets a rotor spin on hover — a small signature
     detail tied to the logo's own shape, not decoration for its own sake.
     Neutralized automatically under prefers-reduced-motion (global.css). */
  .site-header__brand:hover .site-header__logo {
    transform: rotate(360deg);
  }

  .site-header__center {
    justify-self: center;
  }
  .site-header__right {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    justify-self: end;
  }

  /* Hover and active share one visual language (the underline). The
     scramble-text hover (script below) rewrites each .char span's content
     in place, character by character; this component just needs to render
     normally when JS never attaches (non-hover-capable, reduced-motion, or
     no-JS) — the .nav-link__chars wrapper is plain inline text otherwise. */
  .nav-link {
    position: relative;
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;
    color: var(--fg);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    transition: color 200ms ease;
  }
  /* aria-hidden (see markup) — the real accessible name is the <a>'s own
     aria-label, set to the plain, unsplit string. */
  .nav-link__chars {
    display: inline-block;
  }
  /* Fixed width per character slot, not just per word: a min-width on the
     whole word only sets a floor, and random scramble letters (drawn from
     the full alphabet) render wider than a specific word's own letters
     often enough (e.g. "About", "Português") to blow past it anyway,
     reflowing this flex nav row and shifting sibling links. A fixed
     per-character width can't grow no matter which letter is showing, so
     the word's total width — and the row's layout — never moves. */
  .nav-link__chars .char {
    display: inline-block;
    width: 0.72em;
    text-align: center;
  }
  .nav-link:hover {
    color: var(--muted);
  }
  .nav-link.active {
    /* Gold, matching the CTA — not --class-b. Still state (current page),
       just using the accent that's now the site's "premium" signal instead
       of the VFR blue, since the two now sit right next to each other in
       the header and blue read as mismatched next to the gold CTA. */
    color: var(--accent-gold);
  }
  /* Language switch: an icon, not text, so it skips the scramble-hover
     script entirely (that script only touches .char spans — see below) and
     just gets the plain color transition every other .nav-link has. */
  .nav-link--icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .nav-link__icon {
    width: 18px;
    height: 18px;
  }

  /* The one deliberate "primary action" on the page — a solid-fill pill
     rather than the shared underline treatment, so it reads as the single
     thing to click, not another nav destination. Gold, not the blue/magenta
     state accents: reuses --accent-gold (the logo's existing brand-accent
     exception — see global.css) rather than adding a third colour. Fully
     rounded and a hover shine-sweep for the "premium" feel, both pure CSS —
     see the ::before pseudo-element below for the sweep mechanics. */
  .nav-cta {
    position: relative;
    overflow: hidden;
    padding: 0.55rem 1.3rem;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent-gold) 85%, white),
      var(--accent-gold) 55%,
      color-mix(in srgb, var(--accent-gold) 80%, black)
    );
    color: #171200;
    box-shadow: 0 2px 10px color-mix(in srgb, var(--accent-gold) 35%, transparent);
    transition:
      transform 300ms ease,
      box-shadow 300ms ease;
  }
  .nav-cta:hover {
    color: #171200;
    transform: scale(1.05);
    box-shadow: 0 4px 18px color-mix(in srgb, var(--accent-gold) 55%, transparent);
  }
  /* The shine sweep: a skewed light band sitting just off the button's left
     edge, translated across on hover. Skipped by the scramble-hover script
     (it only touches .char spans, which .nav-cta never has) and neutralized
     automatically under prefers-reduced-motion (global.css kills the
     transition duration, so it just doesn't visibly sweep). */
  .nav-cta::before {
    content: '';
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-20deg);
    transition: left 550ms ease;
  }
  .nav-cta:hover::before {
    left: 130%;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  /* Both icons stay put — the thumb sliding over one is the "on" state,
     not a swap. Thumb position itself is driven globally off
     :root[data-theme] (see global.css) so it's correct pre-paint, before
     this component's own script has run. */
  .theme-toggle__track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 44px;
    height: 22px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .theme-toggle__icon {
    position: relative;
    z-index: 1;
    width: 12px;
    height: 12px;
    color: var(--muted);
  }
  .theme-toggle__thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-gold);
    transition: transform 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .menu-toggle {
    display: none;
    justify-self: end;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    padding: 0.4rem;
    color: var(--fg);
    cursor: pointer;
  }
  .menu-toggle__icon {
    width: 24px;
    height: 24px;
  }
  .menu-toggle__icon--close {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--open {
    display: none;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon--close {
    display: block;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
  }
  .site-footer a {
    color: var(--muted);
    text-decoration: none;
  }
  .site-footer__rights {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Native <dialog> centers itself via UA styles already; this just sets
     size/colour/shape. ::backdrop is the dimming layer the browser paints
     behind it — not achievable by styling the dialog itself. */
  .contact-modal {
    width: min(480px, calc(100vw - 3rem));
    max-height: calc(100vh - 4rem);
    padding: 0;
    border: none;
    border-radius: 12px;
    background: var(--bg);
    color: var(--fg);
  }
  .contact-modal::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .contact-form {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
  }
  .contact-form__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 200ms ease;
  }
  .contact-form__close:hover {
    color: var(--fg);
  }
  .contact-form__close svg {
    width: 18px;
    height: 18px;
  }
  .contact-form__heading {
    margin: 0;
    padding-right: 2rem;
  }
  .contact-form__intro {
    margin: -0.5rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .contact-form__field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .contact-form__field input,
  .contact-form__field textarea {
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.6rem 0.75rem;
    resize: vertical;
  }
  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: 2px solid var(--accent-gold);
    outline-offset: -1px;
  }
  /* Off-screen, not display:none — a bot's naive "is this field visible"
     check (offsetWidth/height) is easier to fool than one that actually
     reads computed position, and this defeats both anyway since it's
     simply never in the viewport. */
  .contact-form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .contact-form__submit {
    margin-top: 0.5rem;
    padding: 0.7rem 1.5rem;
    border: none;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent-gold) 85%, white),
      var(--accent-gold) 55%,
      color-mix(in srgb, var(--accent-gold) 80%, black)
    );
    color: #171200;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85rem;
    cursor: pointer;
    transition:
      transform 200ms ease,
      opacity 200ms ease;
  }
  .contact-form__submit:hover {
    transform: scale(1.02);
  }
  .contact-form__submit:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }
  .contact-form__status {
    margin: 0;
    min-height: 1.2em;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .contact-form__status.is-error {
    color: var(--class-e);
  }
  .contact-form__status.is-success {
    color: var(--accent-gold);
  }

  /* Narrow viewports: collapse center/right nav into a hamburger-triggered
     overlay instead of the tight-but-cramped inline layout from the
     previous iteration. */
  @media (max-width: 640px) {
    .site-header {
      gap: 0.75rem;
      padding: 1rem;
      grid-template-columns: auto auto 1fr auto;
    }
    .site-header__logo {
      width: 24px;
      height: 24px;
    }
    .menu-toggle {
      display: inline-flex;
    }

    .site-header__center,
    .site-header__right {
      display: none;
      justify-self: stretch;
    }
    .site-header[data-menu-open='true'] .site-header__center,
    .site-header[data-menu-open='true'] .site-header__right {
      display: flex;
      grid-column: 1 / -1;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      padding-top: 1rem;
    }
    .site-header[data-menu-open='true'] .site-header__right {
      padding-top: 0;
      padding-bottom: 0.5rem;
      border-top: 1px solid var(--border);
      margin-top: 0.5rem;
    }
    .nav-link {
      font-size: 1.1rem;
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import gsap from 'gsap';
  import { prefersReducedMotion } from '../lib/motion-prefs';

  const header = document.getElementById('site-header') as HTMLElement;
  // Every nav link is a real page now (Home/Works/About/Services/language
  // switch) — active state is set server-side via Astro.url.pathname (see
  // BaseLayout's frontmatter), not tracked client-side. This selector is
  // just for the magnetic-hover effect below.
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const reducedMotion = prefersReducedMotion();

  // ---- Lenis smooth scroll ----
  // JS-driven (requestAnimationFrame), so the CSS reduced-motion override
  // (global.css) can't reach it — skip entirely and fall back to plain
  // native scroll (already instant under reduced motion via that same
  // override's `scroll-behavior: auto !important`).
  let lenis: Lenis | null = null;
  if (!reducedMotion) {
    lenis = new Lenis();
    const raf = (time: number) => {
      lenis?.raf(time);
      requestAnimationFrame(raf);
    };
    requestAnimationFrame(raf);

    // Exposed for other pages' own <script> tags (each page's script is a
    // separate module, so it can't see this file's module-scoped `lenis`
    // otherwise) — the Home cluster (src/pages/[lang]/index.astro) reads
    // scroll velocity off this instance to drive its spiral.
    (window as unknown as { __lenis: Lenis }).__lenis = lenis;
    window.dispatchEvent(new CustomEvent('lenis:ready'));
  }

  // ---- GSAP entrance animation ----
  if (!reducedMotion) {
    gsap.from(['.site-header__brand', '.site-header__center', '.site-header__right'], {
      opacity: 0,
      y: -12,
      duration: 0.5,
      ease: 'power2.out',
      stagger: 0.08,
    });
  }

  // ---- Scramble-text hover (pointer-capable devices only) ----
  // Each character cycles through random letters before resolving to the
  // real one, left to right — .nav-cta (the one filled button) is skipped
  // so its label stays stable and readable as a call to action.
  if (!reducedMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const SCRAMBLE_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const DURATION = 1100; // ms — slow, deliberate reveal
    const FLICKER_INTERVAL = 55; // ms between random-character swaps per span

    navLinks.forEach((link) => {
      if (link.classList.contains('nav-cta')) return;
      const spans = [...link.querySelectorAll<HTMLSpanElement>('.char')];
      if (spans.length === 0) return;
      const finalChars = spans.map((span) => span.textContent ?? '');
      let frame = 0;

      const settle = () => {
        cancelAnimationFrame(frame);
        spans.forEach((span, i) => {
          span.textContent = finalChars[i];
        });
      };

      link.addEventListener('mouseenter', () => {
        cancelAnimationFrame(frame);
        const start = performance.now();
        let lastFlicker = 0;
        const step = (now: number) => {
          const elapsed = now - start;
          const dueForFlicker = now - lastFlicker >= FLICKER_INTERVAL;
          if (dueForFlicker) lastFlicker = now;
          let settled = true;
          spans.forEach((span, i) => {
            // Later characters start resolving later, so the reveal reads
            // left-to-right instead of every letter landing at once.
            const revealAt = (i / spans.length) * DURATION * 0.7 + DURATION * 0.3;
            if (elapsed >= revealAt) {
              span.textContent = finalChars[i];
            } else {
              settled = false;
              // Throttled so letters flicker at a calm, readable pace
              // instead of re-randomizing every animation frame (~16ms).
              if (dueForFlicker) {
                span.textContent = SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
              }
            }
          });
          if (!settled) frame = requestAnimationFrame(step);
        };
        frame = requestAnimationFrame(step);
      });

      // Always snap back to the real word on mouseleave — otherwise a quick
      // hover that interrupts the scramble mid-flight would leave the link
      // showing garbled text at rest.
      link.addEventListener('mouseleave', settle);
    });
  }

  // ---- Theme toggle ----
  const themeToggle = document.getElementById('theme-toggle') as HTMLButtonElement;
  const root = document.documentElement;

  // aria-checked="true" means dark — matches the switch's SSR default and
  // the thumb-position CSS in global.css (:root[data-theme]-keyed, so it's
  // already correct pre-paint; this just keeps the accessible state and
  // the label in sync with it after the fact).
  const applyThemeState = () => {
    const isLight = root.dataset.theme === 'light';
    themeToggle.setAttribute('aria-checked', isLight ? 'false' : 'true');
    themeToggle.setAttribute('aria-label', (isLight ? themeToggle.dataset.labelDark : themeToggle.dataset.labelLight) ?? '');
  };
  applyThemeState();

  themeToggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
    applyThemeState();
  });

  // ---- Mobile menu toggle ----
  const menuToggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const isOpen = () => header.dataset.menuOpen === 'true';

  const openMenu = () => {
    header.dataset.menuOpen = 'true';
    menuToggle.setAttribute('aria-expanded', 'true');
    menuToggle.setAttribute('aria-label', menuToggle.dataset.labelClose ?? '');
  };

  function closeMenu() {
    if (!isOpen()) return;
    header.dataset.menuOpen = 'false';
    menuToggle.setAttribute('aria-expanded', 'false');
    menuToggle.setAttribute('aria-label', menuToggle.dataset.labelOpen ?? '');
  }

  menuToggle.addEventListener('click', () => {
    if (isOpen()) closeMenu();
    else openMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });

  // ---- Contact modal ----
  const contactOpen = document.getElementById('contact-open') as HTMLButtonElement | null;
  const contactModal = document.getElementById('contact-modal') as HTMLDialogElement | null;
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  const contactSubmit = document.getElementById('contact-submit') as HTMLButtonElement | null;
  const contactStatus = document.getElementById('contact-status') as HTMLElement | null;

  if (contactOpen && contactModal && contactForm && contactSubmit && contactStatus) {
    contactOpen.addEventListener('click', () => contactModal.showModal());

    // Click on the ::backdrop lands on the <dialog> element itself (it has
    // no other content there) — a click on the form/its children never
    // reaches this listener, since it fires on whatever was actually
    // clicked. This is the standard way to get "click outside to close"
    // out of a native dialog, which doesn't do it by default.
    contactModal.addEventListener('click', (event) => {
      if (event.target === contactModal) contactModal.close();
    });

    // Reset to a clean slate each time it's reopened, so a previous
    // success/error message or filled-in values don't linger.
    contactModal.addEventListener('close', () => {
      contactForm.reset();
      contactStatus.textContent = '';
      contactStatus.className = 'contact-form__status';
    });

    contactForm.addEventListener('submit', async (event) => {
      // The close (X) button is also type="submit" (formmethod="dialog"),
      // so it fires this same submit event — its default action is what
      // actually closes the dialog natively. Only intercept the real send
      // button; let the close button's submit proceed untouched.
      if ((event.submitter as HTMLButtonElement | null)?.formMethod === 'dialog') return;
      event.preventDefault();
      const data = Object.fromEntries(new FormData(contactForm).entries());

      contactSubmit.disabled = true;
      contactSubmit.textContent = contactSubmit.dataset.labelSending ?? contactSubmit.textContent;
      contactStatus.textContent = '';
      contactStatus.className = 'contact-form__status';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (!response.ok) throw new Error('request failed');

        contactStatus.textContent = contactStatus.dataset.success ?? '';
        contactStatus.classList.add('is-success');
        contactForm.reset();
      } catch {
        contactStatus.textContent = contactStatus.dataset.error ?? '';
        contactStatus.classList.add('is-error');
      } finally {
        contactSubmit.disabled = false;
        contactSubmit.textContent = contactSubmit.dataset.labelIdle ?? contactSubmit.textContent;
      }
    });
  }
</script>
