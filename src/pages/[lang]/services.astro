---
// STUB — open tasks 6 & 7 in CLAUDE.md: full services section and the
// Cal.com booking embed aren't built yet. Cal.com must be configured as
// *requires confirmation* (not instant-confirm) since shoots depend on
// weather/daylight/airspace — do not wire up an embed here until that
// constraint is actually being implemented.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isValidLang, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang: langParam } = Astro.params;
if (!langParam || !isValidLang(langParam)) {
  return new Response('Not found', { status: 404 });
}
const lang = langParam as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('services.heading')}>
  <h1>{t('services.heading')}</h1>
  <p>{t('services.comingSoon')}</p>
  <div data-todo="Cal.com embed — requires-confirmation mode, see CLAUDE.md open task 7"></div>
</BaseLayout>
