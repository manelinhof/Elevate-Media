---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { getProjects } from '../../lib/projects';
import { computeClusterLayout } from '../../lib/cluster-layout';
import { isValidLang, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang: langParam } = Astro.params;
if (!langParam || !isValidLang(langParam)) {
  return new Response('Not found', { status: 404 });
}
const lang = langParam as Lang;
const t = useTranslations(lang);

const projects = getProjects();
const mediaBase = Astro.locals.runtime.env.PUBLIC_MEDIA_BASE;

// Home is the cluster — full stop, at every width, and nothing else on
// the page besides the shared header/footer (BaseLayout). The practical
// browsing experience (headline, tagline, category filters, plain grid)
// lives on the separate /work/ listing page; About and Services are their
// own routes too — see src/pages/[lang]/about and .../services.
const clusterPositions = computeClusterLayout(projects.length);
---

<BaseLayout lang={lang} title={t('home.heading')}>
  <section id="home">
    {projects.length === 0 ? (
      <p class="empty">{t('home.empty')}</p>
    ) : (
      <div class="cluster-wrapper">
        <img src="/logo.png" alt="" class="cluster-logo" />
        <div class="grid cluster">
          {projects.map((project, i) => (
            <div class="tile-position" style={clusterPositions[i]}>
              <ProjectTile project={project} lang={lang} mediaBase={mediaBase} spinning />
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  #home {
    padding: 3rem 1.5rem;
  }
  .empty {
    color: var(--muted);
  }

  /* Wide, gently-tilted spiral cluster (cipher.tv-derived, matching their
     actual rx/ry/tilt proportions — see cluster-layout.ts) — the only thing
     Home shows, at every viewport width (vmin-based sizing scales down
     naturally on phones). Each tile's position is driven every frame by the
     page's script tag below (--x/--y custom properties), which also handles
     the SSR resting state before JS runs / under prefers-reduced-motion —
     see src/lib/cluster-layout.ts and the script tag for the full picture. */
  .cluster-wrapper {
    position: relative;
  }
  .grid.cluster {
    display: block;
    position: relative;
    height: 60vmin;
  }
  .grid.cluster .tile-position {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--w);
    height: var(--h);
    transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y)));
  }
  /* Sits outside .grid.cluster (a sibling, not a descendant) — a fixed,
     non-moving landmark at the center of the path tiles travel around. */
  .cluster-logo {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6vmin;
    height: auto;
    object-fit: contain;
    opacity: 0.85;
    pointer-events: none;
    z-index: 1;
  }
</style>

<script>
  // Velocity-driven spiral, matching cipher.tv's own reference values as
  // closely as this DOM/CSS site can (see project plan notes — their real
  // scene-controller source was pulled from its JS bundle: a wide ellipse,
  // gently tilted, not the tall/45°-tilted shape we tried first, which read
  // as each tile spinning in place rather than a legible shared spiral).
  // Every tile shares one elliptical path (buildEllipseLUT/getEllipsePoint,
  // arc-length parametrized so all tiles move at the same visual speed) and
  // one shared `time` scalar, offset per-tile so they're evenly spaced along
  // it. Tiles drift continuously on their own (BASE_SPEED, cipher's exact
  // constant); scrolling (wheel input) adds a decaying bonus on top — it
  // speeds up, slows down, or reverses the drift, but never "completes"
  // anything.
  //
  // Scroll input is dedicated entirely to the spiral, not the page: wheel
  // events are preventDefault'd here and Lenis is stopped for this page, so
  // nothing on Home actually scrolls — matching cipher.tv itself, whose
  // works page has no real scroll height at all. (The footer below the
  // cluster is consequently only reachable via header nav on this page, not
  // by scrolling past it — a deliberate tradeoff, flagged since it's a
  // change from the plain-scroll behavior every other page still has.)
  //
  // Reduced-motion visitors skip this entirely and keep the SSR resting
  // layout from computeClusterLayout (t = i/count, at time = 0) — no script
  // attempts to run, consistent with every other motion gate in this codebase.
  import {
    buildEllipseLUT,
    getEllipsePoint,
    RX_DESKTOP,
    RY_DESKTOP,
    TILT_DESKTOP,
    RX_MOBILE,
    RY_MOBILE,
    TILT_MOBILE,
    MOBILE_BREAKPOINT,
  } from '../../lib/cluster-layout';
  import { prefersReducedMotion } from '../../lib/motion-prefs';

  const tiles = [...document.querySelectorAll<HTMLElement>('.tile-position')];

  if (tiles.length > 0 && !prefersReducedMotion()) {
    const BASE_SPEED = 0.015; // idle drift, cipher's exact constant
    const WHEEL_INFLUENCE = 0.0006; // tunable — how much wheel deltaY nudges the drift
    const VELOCITY_DECAY = 0.6; // per-frame decay of the scroll bonus, cipher's own constant

    const isMobile = window.innerWidth <= MOBILE_BREAKPOINT;
    const lut = buildEllipseLUT(
      isMobile ? RX_MOBILE : RX_DESKTOP,
      isMobile ? RY_MOBILE : RY_DESKTOP,
      isMobile ? TILT_MOBILE : TILT_DESKTOP
    );
    const count = tiles.length;
    let time = 0;
    let scrollBonus = 0;

    window.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();
        scrollBonus += event.deltaY * WHEEL_INFLUENCE;
      },
      { passive: false }
    );

    function onLenisReady() {
      // Stop Lenis's own smooth-scroll entirely on this page — the wheel
      // listener above already owns scroll input, and letting Lenis also
      // process it would fight the "nothing scrolls" goal.
      (window as unknown as { __lenis?: { stop: () => void } }).__lenis?.stop();
    }
    if ((window as unknown as { __lenis?: unknown }).__lenis) onLenisReady();
    else window.addEventListener('lenis:ready', onLenisReady, { once: true });

    let last = performance.now();
    function render(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      scrollBonus *= VELOCITY_DECAY;
      time += (BASE_SPEED + scrollBonus) * dt;
      tiles.forEach((el, i) => {
        const { x, y } = getEllipsePoint(lut, i / count + time);
        el.style.setProperty('--x', `${x}vmin`);
        el.style.setProperty('--y', `${y}vmin`);
      });
      requestAnimationFrame(render);
    }
    requestAnimationFrame(render);
  }
</script>
