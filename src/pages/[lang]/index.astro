---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { getProjects } from '../../lib/projects';
import { computeClusterLayout } from '../../lib/cluster-layout';
import { isValidLang, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang: langParam } = Astro.params;
if (!langParam || !isValidLang(langParam)) {
  return new Response('Not found', { status: 404 });
}
const lang = langParam as Lang;
const t = useTranslations(lang);

const projects = getProjects();
const mediaBase = Astro.locals.runtime.env.PUBLIC_MEDIA_BASE;

// Home is the cluster — full stop, at every width, and nothing else on
// the page besides the shared header/footer (BaseLayout). The practical
// browsing experience (headline, tagline, category filters, plain grid)
// lives on the separate /work/ listing page; About and Services are their
// own routes too — see src/pages/[lang]/about and .../services.
const clusterPositions = computeClusterLayout(projects.length);
---

<BaseLayout lang={lang} title={t('home.heading')} hideFooter>
  <section id="home">
    {projects.length === 0 ? (
      <p class="empty">{t('home.empty')}</p>
    ) : (
      <div class="cluster-wrapper">
        <span class="cluster-logo" aria-hidden="true"></span>
        <div class="grid cluster">
          {projects.map((project, i) => (
            <div class="tile-position" style={clusterPositions[i]}>
              <ProjectTile project={project} lang={lang} mediaBase={mediaBase} spinning />
            </div>
          ))}
        </div>
      </div>
    )}
    <!-- Takes over the footer's space: empty at rest, filled with the
         hovered cluster tile's title by ProjectTile.astro's script (it
         looks for this id and no-ops if absent, e.g. on the Works page's
         plain grid). -->
    <p id="hover-label" class="hover-label" aria-live="polite"></p>
  </section>
</BaseLayout>

<style>
  /* 100vh minus the sticky header's own rendered height (~76px desktop,
     ~69px mobile — one shared value is close enough at both), not a bare
     100vh: #home's box starts right after the header in normal flow, so
     centering *within* #home alone would center on the viewport-minus-
     header midpoint, not the true viewport center — the cluster would
     read as sitting low. Home never scrolls (wheel is dedicated to the
     spiral, Lenis is stopped — see the script tag below), so if this
     estimate runs a few px short on some device, the harmless result is
     a few px of unreachable overflow, not a broken layout. */
  #home {
    min-height: calc(100vh - 78px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1.5rem;
    box-sizing: border-box;
  }
  .empty {
    color: var(--muted);
  }

  /* Sits where the footer used to — fixed to the viewport bottom, not page
     flow, since Home never scrolls (see the script tag below). Empty and
     invisible at rest; ProjectTile.astro's script fills it with the
     hovered cluster tile's title and fades it in. */
  .hover-label {
    position: fixed;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    margin: 0;
    text-align: center;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    color: var(--muted);
    opacity: 0;
    transition: opacity 300ms ease;
    pointer-events: none;
  }
  .hover-label.is-visible {
    opacity: 1;
  }

  /* Wide, gently-tilted spiral cluster (cipher.tv-derived, matching their
     actual rx/ry/tilt proportions — see cluster-layout.ts) — the only thing
     Home shows, at every viewport width (vmin-based sizing scales down
     naturally on phones). Each tile's position is driven every frame by the
     page's script tag below (--x/--y custom properties), which also handles
     the SSR resting state before JS runs / under prefers-reduced-motion —
     see src/lib/cluster-layout.ts and the script tag for the full picture. */
  .cluster-wrapper {
    position: relative;
  }
  .grid.cluster {
    display: block;
    position: relative;
    height: 75vmin;
  }
  .grid.cluster .tile-position {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--w);
    height: var(--h);
    transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y)));
  }
  /* Sits outside .grid.cluster (a sibling, not a descendant) — stays
     centered on the path tiles travel around, but spins in place on the
     same scroll-driven `time` value as the tiles (see the script tag
     below). This static transform is the SSR/reduced-motion resting state
     (centered, unrotated); the script overrides it every frame otherwise. */
  /* Rendered as a CSS mask, not an <img>, so its colour follows
     --logo-color (var(--fg) normally, yellow in light mode — see
     global.css and CLAUDE.md's "colour is state" exception) rather than
     the flat grey baked into logo.png. */
  .cluster-logo {
    display: block;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6vmin;
    aspect-ratio: 1;
    background-color: var(--logo-color);
    mask: url('/logo.png') center / contain no-repeat;
    -webkit-mask: url('/logo.png') center / contain no-repeat;
    opacity: 0.85;
    pointer-events: none;
    z-index: 1;
    transition: background-color 300ms ease;
  }
</style>

<script>
  // Velocity-driven spiral, matching cipher.tv's own reference values as
  // closely as this DOM/CSS site can (see project plan notes — their real
  // scene-controller source was pulled from its JS bundle: a wide ellipse,
  // gently tilted, not the tall/45°-tilted shape we tried first, which read
  // as each tile spinning in place rather than a legible shared spiral).
  // Every tile shares one elliptical path (buildEllipseLUT/getEllipsePoint,
  // arc-length parametrized so all tiles move at the same visual speed) and
  // one shared `time` scalar, offset per-tile so they're evenly spaced along
  // it. Tiles drift continuously on their own (BASE_SPEED, cipher's exact
  // constant); scrolling (wheel input) adds a decaying bonus on top — it
  // speeds up, slows down, or reverses the drift, but never "completes"
  // anything.
  //
  // Scroll input is dedicated entirely to the spiral, not the page: wheel
  // events are preventDefault'd here and Lenis is stopped for this page, so
  // nothing on Home actually scrolls — matching cipher.tv itself, whose
  // works page has no real scroll height at all. (The footer below the
  // cluster is consequently only reachable via header nav on this page, not
  // by scrolling past it — a deliberate tradeoff, flagged since it's a
  // change from the plain-scroll behavior every other page still has.)
  //
  // Reduced-motion visitors skip this entirely and keep the SSR resting
  // layout from computeClusterLayout (t = i/count, at time = 0) — no script
  // attempts to run, consistent with every other motion gate in this codebase.
  import gsap from 'gsap';
  import {
    buildEllipseLUT,
    getEllipsePoint,
    RX_DESKTOP,
    RY_DESKTOP,
    TILT_DESKTOP,
    RX_MOBILE,
    RY_MOBILE,
    TILT_MOBILE,
    MOBILE_BREAKPOINT,
  } from '../../lib/cluster-layout';
  import { prefersReducedMotion } from '../../lib/motion-prefs';

  const tiles = [...document.querySelectorAll<HTMLElement>('.tile-position')];
  const logo = document.querySelector<HTMLElement>('.cluster-logo');

  if (tiles.length > 0 && !prefersReducedMotion()) {
    // ---- Entrance: the cluster "blooms" outward from the center on load ----
    // Animates the inner .tile (opacity/scale), never .tile-position itself —
    // .tile-position's own transform is owned entirely by the spiral's
    // --x/--y custom properties (see the render loop below); animating a
    // transform directly on it here would fight that and desync its
    // position. The child .tile has no competing transform of its own at
    // rest (only ever on :hover), so it's safe to animate independently —
    // clearProps strips the tween's inline styles once it finishes so that
    // :hover scaling and the dim-siblings opacity toggle (ProjectTile.astro)
    // both still work normally afterward; a lingering inline style would
    // otherwise permanently block them (inline always beats a stylesheet
    // rule, regardless of selector).
    // Runs concurrently with the spiral's own rAF loop below, not before
    // it — tiles are already gently drifting along their path while they
    // bloom in, rather than sitting static-then-starting, which reads as
    // more alive for a page that's meant to feel constantly in motion.
    const tileEls = tiles.map((pos) => pos.querySelector<HTMLElement>('.tile')).filter((el) => el !== null);
    const introTl = gsap.timeline({ delay: 0.15 });
    if (logo) {
      introTl.from(logo, { opacity: 0, scale: 0.3, duration: 0.6, ease: 'back.out(1.7)' }, 0);
    }
    introTl.from(
      tileEls,
      {
        opacity: 0,
        scale: 0.3,
        duration: 0.85,
        ease: 'back.out(1.6)',
        stagger: { each: 0.045, from: 'center' },
        clearProps: 'opacity,transform',
      },
      0.05
    );

    const BASE_SPEED = 0.015; // idle drift, cipher's exact constant
    const WHEEL_INFLUENCE = 0.0006; // tunable — how much wheel deltaY nudges the drift
    const VELOCITY_DECAY = 0.6; // per-frame decay of the scroll bonus, cipher's own constant

    const isMobile = window.innerWidth <= MOBILE_BREAKPOINT;
    const lut = buildEllipseLUT(
      isMobile ? RX_MOBILE : RX_DESKTOP,
      isMobile ? RY_MOBILE : RY_DESKTOP,
      isMobile ? TILT_MOBILE : TILT_DESKTOP
    );
    const count = tiles.length;
    let time = 0;
    let scrollBonus = 0;

    window.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();
        scrollBonus += event.deltaY * WHEEL_INFLUENCE;
      },
      { passive: false }
    );

    function onLenisReady() {
      // Stop Lenis's own smooth-scroll entirely on this page — the wheel
      // listener above already owns scroll input, and letting Lenis also
      // process it would fight the "nothing scrolls" goal.
      (window as unknown as { __lenis?: { stop: () => void } }).__lenis?.stop();
    }
    if ((window as unknown as { __lenis?: unknown }).__lenis) onLenisReady();
    else window.addEventListener('lenis:ready', onLenisReady, { once: true });

    let last = performance.now();
    let spiralRunning = true;
    function render(now: number) {
      if (!spiralRunning) return;
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      scrollBonus *= VELOCITY_DECAY;
      time += (BASE_SPEED + scrollBonus) * dt;
      tiles.forEach((el, i) => {
        const { x, y } = getEllipsePoint(lut, i / count + time);
        el.style.setProperty('--x', `${x}vmin`);
        el.style.setProperty('--y', `${y}vmin`);
      });
      // The center logo rotates in place on the same `time` value driving
      // the tiles — one full spin per full spiral loop — so it visibly
      // speeds up/reverses with scroll exactly like the tiles do, instead
      // of sitting inert while everything around it moves.
      if (logo) {
        logo.style.transform = `translate(-50%, -50%) rotate(${time * 360}deg)`;
      }
      requestAnimationFrame(render);
    }
    requestAnimationFrame(render);

    // ---- Exit: the cluster closes itself before handing off to a project ----
    // Clicking a tile doesn't navigate immediately — it stops the spiral,
    // collapses every tile back toward the shared center while fading out
    // (the reverse of the entrance bloom above), then navigates once that
    // finishes. Modified clicks (ctrl/cmd/shift/middle-click) are left
    // alone so opening in a new tab still works normally.
    let closing = false;
    tiles.forEach((pos) => {
      const link = pos.querySelector<HTMLAnchorElement>('.tile');
      if (!link) return;
      link.addEventListener('click', (event) => {
        if (closing || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }
        event.preventDefault();
        closing = true;
        spiralRunning = false;

        const href = link.href;
        const closeTl = gsap.timeline({
          onComplete: () => {
            window.location.href = href;
          },
        });

        // Position collapse: tweens each tile-position's current --x/--y
        // down to 0 (the center) via a plain numeric proxy object, not a
        // direct custom-property tween — this only ever needs to read the
        // vars once (their current value the instant the spiral stopped)
        // and write them back every tick through onUpdate, which sidesteps
        // relying on GSAP's own CSS-custom-property unit parsing.
        tiles.forEach((el) => {
          const computed = getComputedStyle(el);
          const state = {
            x: parseFloat(computed.getPropertyValue('--x')) || 0,
            y: parseFloat(computed.getPropertyValue('--y')) || 0,
          };
          closeTl.to(
            state,
            {
              x: 0,
              y: 0,
              duration: 0.6,
              ease: 'power2.in',
              onUpdate: () => {
                el.style.setProperty('--x', `${state.x}vmin`);
                el.style.setProperty('--y', `${state.y}vmin`);
              },
            },
            0
          );
        });

        // Shrink/fade each tile's own element (safe to animate directly —
        // see the entrance comment above for why .tile-position itself
        // isn't touched here), staggered from the center outward so the
        // collapse reads as one continuous motion with the position tween.
        closeTl.to(
          tileEls,
          { opacity: 0, scale: 0.2, duration: 0.5, ease: 'power2.in', stagger: { each: 0.025, from: 'center' } },
          0
        );
        if (logo) {
          closeTl.to(logo, { opacity: 0, scale: 0.4, duration: 0.4, ease: 'power2.in' }, 0.1);
        }
      });
    });
  }
</script>
