---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { getProjects } from '../../lib/projects';
import { computeClusterLayout } from '../../lib/cluster-layout';
import { activeCategories, BRAND } from '../../data/site';
import { isValidLang, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang: langParam } = Astro.params;
if (!langParam || !isValidLang(langParam)) {
  return new Response('Not found', { status: 404 });
}
const lang = langParam as Lang;
const t = useTranslations(lang);

const projects = getProjects();
const categories = activeCategories(projects);
const mediaBase = Astro.locals.runtime.env.PUBLIC_MEDIA_BASE;
const heroProject = projects.find((p) => p.featured) ?? projects[0];

// Below this many projects, a scattered cluster just looks like empty
// space with a couple of rectangles in it — keep the plain grid until
// there's enough real work (via ingest.sh) to make it worth scattering.
const MIN_PROJECTS_FOR_CLUSTER = 6;
const useCluster = projects.length >= MIN_PROJECTS_FOR_CLUSTER;
const clusterPositions = useCluster ? computeClusterLayout(projects.length) : [];

const services = [
  t('about.services.fpv'),
  t('about.services.realEstate'),
  t('about.services.hotels'),
  t('about.services.tourism'),
  t('about.services.events'),
  t('about.services.automotive'),
  t('about.services.flythrough'),
];

const equipment = [
  t('about.equipment.airUnit'),
  t('about.equipment.frame'),
  t('about.equipment.camera'),
  t('about.equipment.grading'),
];
---

<BaseLayout lang={lang} title={t('home.heading')}>
  <section id="work">
    <div class="content">
      {categories.length > 0 && (
        <ul class="categories">
          {categories.map((c) => (
            <li class="label">{c[lang]}</li>
          ))}
        </ul>
      )}

      {projects.length === 0 ? (
        <p>{t('home.empty')}</p>
      ) : (
        <div class:list={['grid', { cluster: useCluster }]}>
          {projects.map((project, i) =>
            useCluster ? (
              <div class="tile-position" style={clusterPositions[i]}>
                <ProjectTile project={project} lang={lang} mediaBase={mediaBase} spinning />
              </div>
            ) : (
              <ProjectTile project={project} lang={lang} mediaBase={mediaBase} />
            )
          )}
        </div>
      )}
    </div>

    {heroProject && <Hero project={heroProject} lang={lang} mediaBase={mediaBase} />}
  </section>

  <section id="about">
    <h2>{t('about.heading')}</h2>
    <p class="intro">{t('about.intro')}</p>

    <div class="group">
      <h3>{t('about.services.heading')}</h3>
      <ul class="prose-list">
        {services.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="group">
      <h3>{t('about.equipment.heading')}</h3>
      <ul class="prose-list">
        {equipment.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <div class="social">
      <p>{t('about.social.stat')}</p>
      <a href={BRAND.instagramUrl} target="_blank" rel="noopener noreferrer" class="label">
        {t('about.social.cta')} — {BRAND.instagramHandle}
      </a>
    </div>
  </section>

  <section id="services">
    <h2>{t('services.heading')}</h2>
    <p>{t('services.comingSoon')}</p>
    <div data-todo="Cal.com embed — requires-confirmation mode, see CLAUDE.md open task 7"></div>
  </section>
</BaseLayout>

<style>
  /* Hero inside #work stays full-bleed (no padding on the section itself);
     only the grid/categories wrapper below it is padded. */
  #work .content {
    padding: 3rem 1.5rem;
  }
  #about,
  #services {
    padding: 3rem 1.5rem;
    max-width: 720px;
  }

  .categories {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2.5rem 1.5rem;
  }

  /* Scattered cipher.tv-style cluster — desktop only, and only once there
     are enough projects (see MIN_PROJECTS_FOR_CLUSTER) to look intentional
     rather than sparse. Below this width/count, the plain grid above
     applies unchanged — same proven, data-conscious mobile layout.

     The whole cluster slowly rotates as one rigid disc (cluster-spin);
     each tile counter-rotates at the same speed via --cluster-spin-duration
     (ProjectTile.astro's .tile--spin, inherited through this custom
     property) so its own poster/video stays upright while only its
     *position* orbits. prefers-reduced-motion already forces all
     animation-duration to ~0 globally (see global.css), so this is
     automatically disabled for those users — no extra gating needed. */
  @media (min-width: 960px) {
    .grid.cluster {
      display: block;
      position: relative;
      height: 85vmin;
      --cluster-spin-duration: 180s;
      animation: cluster-spin var(--cluster-spin-duration) linear infinite;
      transform-origin: center center;
    }
    .grid.cluster .tile-position {
      position: absolute;
      left: 50%;
      top: 50%;
      width: var(--w);
      height: var(--h);
      transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y)));
    }
  }
  @keyframes cluster-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  #about .intro {
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.25rem);
    color: var(--muted);
    max-width: 60ch;
    margin: 1.5rem 0 3rem;
  }
  .group {
    margin-bottom: 2.5rem;
  }
  .group h3 {
    margin-bottom: 1rem;
  }
  .prose-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .prose-list li {
    padding-left: 1.25rem;
    position: relative;
  }
  .prose-list li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--muted);
  }
  .social {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .social a {
    text-decoration: none;
    color: var(--class-b);
  }
</style>
