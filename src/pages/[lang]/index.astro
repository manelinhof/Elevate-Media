---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { getProjects } from '../../lib/projects';
import { activeCategories } from '../../data/site';
import { isValidLang, useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';

const { lang: langParam } = Astro.params;
if (!langParam || !isValidLang(langParam)) {
  return new Response('Not found', { status: 404 });
}
const lang = langParam as Lang;
const t = useTranslations(lang);

const projects = getProjects();
const categories = activeCategories(projects);
const mediaBase = Astro.locals.runtime.env.PUBLIC_MEDIA_BASE;
---

<BaseLayout lang={lang} title={t('home.heading')}>
  <h1>{t('home.heading')}</h1>

  {categories.length > 0 && (
    <ul class="categories">
      {categories.map((c) => <li>{c[lang]}</li>)}
    </ul>
  )}

  {projects.length === 0 ? (
    <p>{t('home.empty')}</p>
  ) : (
    <div class="grid">
      {projects.map((project) => (
        <ProjectTile project={project} lang={lang} mediaBase={mediaBase} />
      ))}
    </div>
  )}
</BaseLayout>

<style>
  .categories {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    padding: 0 1.5rem;
    color: var(--muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    padding: 1.5rem;
  }
</style>
